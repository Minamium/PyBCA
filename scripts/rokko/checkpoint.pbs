#!/bin/bash
#PBS -N pybca_restart
#PBS -q G
#PBS -l select=1:ngpus=4:ncpus=16:mem=64gb
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load cuda/11.8.0 gcc/11.4.0
export PATH=/home/IM25D029/PyBCA_workspcace/venv/bin:$PATH
export PYTHONPATH="$PWD/src:$PWD/tests${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1 PYBCA_TEST_DEVICE=cuda
export PYBCA_CUDA_CACHE="$PWD/results/cuda-cache"
mkdir -p results/logs
exec > >(tee "results/logs/checkpoint-${PBS_JOBID}.log") 2>&1
python -m unittest test_core_runtime.StreamingTests -v
RUN_ROOT="results/checkpoint-${PBS_JOBID}"
GPU_COUNT=$(python -c 'import torch; print(torch.cuda.device_count())')
# Includes naturally occurring BCA-IP events before restart.
python -m torch.distributed.run --standalone --nproc-per-node="$GPU_COUNT" scripts/run_bca_ip.py \
  --output-dir "$RUN_ROOT/full" --trials 16 --steps 30000
python -m torch.distributed.run --standalone --nproc-per-node="$GPU_COUNT" scripts/run_bca_ip.py \
  --output-dir "$RUN_ROOT/resumed" --trials 16 --steps 15000
python -m torch.distributed.run --standalone --nproc-per-node="$GPU_COUNT" scripts/run_bca_ip.py \
  --output-dir "$RUN_ROOT/resumed" --trials 16 --steps 30000 --resume
python scripts/compare_runs.py "$RUN_ROOT/full" "$RUN_ROOT/resumed" \
  --output "$RUN_ROOT/restart-parity.json"
