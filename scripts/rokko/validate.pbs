#!/bin/bash
#PBS -N pybca_validate
#PBS -q G
#PBS -l select=1:ngpus=1:ncpus=4:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load cuda/11.8.0 gcc/11.4.0
export PATH=/home/IM25D029/PyBCA_workspcace/venv/bin:$PATH
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
export PYBCA_TEST_DEVICE=cuda
export PYBCA_CUDA_CACHE="$PWD/results/cuda-cache"
mkdir -p results/logs
exec > >(tee "results/logs/validation-${PBS_JOBID}.log") 2>&1
python -m unittest discover -s tests -p 'test_core_runtime.py' -v
if test -f tests/validate_core.py; then
  python tests/validate_core.py --device cuda --output results/validation.json
fi
