#!/bin/bash
#PBS -N pybca_experiment
#PBS -q G
#PBS -l select=1:ngpus=8:ncpus=32:mem=96gb
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
module load cuda/11.8.0 gcc/11.4.0
export PATH=/home/IM25D029/PyBCA_workspcace/venv/bin:$PATH
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
export PYBCA_CUDA_CACHE="$PWD/results/cuda-cache"
: "${PYBCA_RUN_DIR:?Set PYBCA_RUN_DIR to a new run directory, or use PYBCA_RESUME=1}"
mkdir -p results/logs
exec > >(tee "results/logs/experiment-${PBS_JOBID}.log") 2>&1
GPU_COUNT=$(python -c 'import torch; print(torch.cuda.device_count())')
RUN_ARGS=(--output-dir "$PYBCA_RUN_DIR" --trials "${PYBCA_TRIALS:-64}"
          --steps "${PYBCA_STEPS:-2000000}" --seed "${PYBCA_SEED:-20260923}"
          --trial-start "${PYBCA_TRIAL_START:-0}")
if [[ "${PYBCA_RESUME:-0}" == 1 ]]; then RUN_ARGS+=(--resume); fi
python -m torch.distributed.run --standalone --nproc-per-node="$GPU_COUNT" \
  scripts/run_bca_ip.py "${RUN_ARGS[@]}"
