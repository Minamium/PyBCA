    place.cell(io_a.x, io_a.y+3, 1)
    place.cell(io_a.x-1, io_a.y+4, 1)
    place.cell(io_a.x-1, io_a.y+5, 5)
    place.cell(io_a.x-2, io_a.y+6, 1)
    place.cell(io_a.x, io_a.y+6, 1)
}

element Join_Fork_left(io_a){
    place.cell(io_a.x-6, io_a.y, 1)
    place.cell(io_a.x-3, io_a.y, 1)
    place.cell(io_a.x, io_a.y, 1)
    place.cell(io_a.x-5, io_a.y+1, 5)
    place.cell(io_a.x-4, io_a.y+1, 1)
    place.cell(io_a.x-3, io_a.y+1, 1)
    place.cell(io_a.x-2, io_a.y+1, 1)
