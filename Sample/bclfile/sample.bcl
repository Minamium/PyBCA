element exma(io_a){
    place.cell(io_a.x, io_a.y-2, 1)
    place.cell(io_a.x, io_a.y-1, 1)
    place.cell(io_a.x-2, io_a.y, 1)
    place.cell(io_a.x-1, io_a.y, 1)
    place.cell(io_a.x, io_a.y, 1)
    place.cell(io_a.x+1, io_a.y, 1)
    place.cell(io_a.x+2, io_a.y, 1)
    place.cell(io_a.x, io_a.y+1, 1)
    place.cell(io_a.x, io_a.y+2, 1)
}

